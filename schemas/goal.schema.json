{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoPilot OS Goal Specification",
  "type": "object",
  "required": [
    "goal",
    "scope",
    "operations",
    "constraints",
    "success_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/createDirectory"
          },
          {
            "$ref": "#/$defs/moveFile"
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "allow_delete",
        "allow_overwrite",
        "preview_required"
      ],
      "additionalProperties": false,
      "properties": {
        "allow_delete": {
          "const": false
        },
        "allow_overwrite": {
          "const": false
        },
        "preview_required": {
          "const": true
        }
      }
    },
    "success_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/(?:[^/]+/)*\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])/(?:[^/]+/)*[^/]+$"
    },
    "createDirectory": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "CreateDirectory"
        },
        "parameters": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "moveFile": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "MoveFile"
        },
        "parameters": {
          "type": "object",
          "required": [
            "source",
            "destination"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/$defs/path"
            },
            "destination": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    }
  }
}
